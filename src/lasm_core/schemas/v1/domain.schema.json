{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lasm-core:schema:v1:domain",
  "title": "Lasm core interchange records, version 1",
  "$defs": {
    "JsonNumber": {
      "description": "A finite JSON number; integer-valued numbers must be within the JavaScript safe-integer range.",
      "type": "number",
      "if": {
        "type": "integer"
      },
      "then": {
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/JsonNumber"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "EvidencePayload": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "ValidationSeverity": {
      "enum": [
        "error",
        "warning"
      ]
    },
