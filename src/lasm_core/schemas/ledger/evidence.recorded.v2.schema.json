{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lasm-core:ledger:evidence.recorded:v2",
  "title": "Lasm evidence.recorded ledger event data, version 2",
  "$defs": {
    "AdapterIdentity": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "served": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "route": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "model",
        "host",
        "served"
      ],
      "additionalProperties": false
    },
    "EvidenceRecordedDataV2": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string"
        },
        "attempt": {
          "$ref": "#/$defs/SafeInteger"
        },
        "runKind": {
          "type": "string"
        },
        "recordsDigest": {
          "type": "string"
        },
        "patchrigCommit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40
        },
        "claimScope": {
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterIdentity"
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeasurementItem"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunInput"
          }
        },
        "fixture": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "preregistration": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "attempt",
        "runKind",
        "recordsDigest",
        "patchrigCommit",
        "claimScope",
        "adapter",
        "measurements"
      ],
      "additionalProperties": false
    },
    "JsonNumber": {
      "description": "A finite JSON number; integer-valued numbers must be within the JavaScript safe-integer range.",
      "type": "number",
      "if": {
        "type": "integer"
      },
      "then": {
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/JsonNumber"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "MeasurementItem": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string"
        },
        "tunedThreshold": {
          "$ref": "#/$defs/JsonNumber"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "RunInput": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "recordsDigest": {
          "type": "string"
        },
        "seeds": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "runId",
        "recordsDigest"
      ],
      "additionalProperties": false
    },
    "SafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "$ref": "#/$defs/EvidenceRecordedDataV2"
}
