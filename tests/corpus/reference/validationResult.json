  {
    "id": "validation-result.mixed",
    "function": "validationResult",
    "description": "Errors invalidate and finding order is kept.",
    "args": [
      [
        {
          "code": "x.warning",
          "severity": "warning",
          "path": "y",
          "message": "A warning."
        },
        {
          "code": "x.error",
          "severity": "error",
          "path": "x",
          "message": "An error."
        },
        {
          "code": "x.warning",
          "severity": "warning",
          "path": "y",
          "message": "A warning."
        }
      ]
    ],
    "expected": {
      "valid": false,
      "findings": [
        {
          "code": "x.warning",
          "severity": "warning",
          "path": "y",
          "message": "A warning."
        },
        {
          "code": "x.error",
          "severity": "error",
          "path": "x",
          "message": "An error."
        },
        {
          "code": "x.warning",
          "severity": "warning",
          "path": "y",
          "message": "A warning."
        }
      ]
    }
  }
