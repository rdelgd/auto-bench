          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "ValidationResult": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          }
        }
      },
      "required": [
        "valid",
        "findings"
      ],
      "additionalProperties": false
    },
