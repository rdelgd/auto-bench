          "severity": "error",
          "path": "trace[0].type",
          "message": "Unknown agentic event type: custom.event"
        },
        {
          "code": "trace.missing_actor",
          "severity": "error",
          "path": "trace[0].actorId",
          "message": "Trace events require an actor identifier."
        },
        {
          "code": "trace.invalid_sequence",
          "severity": "error",
          "path": "trace[0].sequence",
          "message": "Sequence must be a non-negative integer."
        }
      ]
    }
